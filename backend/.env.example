# Explicit storage choice: tinydb for local use; mongodb for cloud deployment.
DB_BACKEND=tinydb
MONGODB_URI=
MONGODB_DATABASE=climatrace
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add the exact production API hostname for non-Render deployments/custom domains.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_PER_MINUTE=30
ANALYSIS_LIMIT_PER_MINUTE=6
